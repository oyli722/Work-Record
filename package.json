{
  "name": "mework",
  "version": "1.1.0",
  "description": "本地工作记录管理桌面应用（Electron + React + JS）。WorkRecord 的极简重构：砍掉 AI 与日程，保留工作区 + 文件编辑，新增标签页。",
  "main": "out/main/index.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "node --test",
    "dist": "cross-env HTTPS_PROXY=http://127.0.0.1:7897 HTTP_PROXY=http://127.0.0.1:7897 npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.mework.app",
    "productName": "MeWork",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**"
    ],
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "cross-env": "^10.1.0",
    "electron": "^41.7.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.13",
    "markdown-it": "^15.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
